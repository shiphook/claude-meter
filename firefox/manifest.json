{
  "manifest_version": 3,
  "name": "Shiphook Claude Meter",
  "description": "On-device Claude.ai usage and context tracker \u2014 session/weekly limits, approximate tokens, tool breakdown. Never sends data off-device.",
  "version": "0.1.11",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-meter@shiphook.dev",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/page/fetch-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/ui/overlay.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page/fetch-hook.js",
        "src/ui/*"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Shiphook Claude Meter"
  }
}
